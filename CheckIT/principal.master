<%@ Master Language="C#" AutoEventWireup="true" CodeFile="principal.master.cs" Inherits="principal" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />    
<link rel="stylesheet" href="css/bootstrap.css" />
<link rel="stylesheet" href="Content/Site.css" />
    <title>AssessHub — Panel supervisor</title>
    
    <asp:ContentPlaceHolder id="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <header role="banner" class="navbar navbar-inverse navbar-fixed-top ah-navbar">
          <div class="container">
              <div class="navbar-header">
                  <a class="navbar-brand ah-brand" href="./">AssessHub</a>
              </div>
              <nav role="navigation" class="collapse navbar-collapse bs-navbar-collapse">
                  <ul class="nav navbar-nav">
                      <li><a href="./Default.aspx">Candidatos</a></li>
                  </ul>
              </nav>

          </div>
        </header>
        <div class ="clearfix"></div>
        <div id="main" style="padding-top:70px;">
            <div class="container body-content">
                <div class="pull-right" style="margin-bottom:16px;">
                    <asp:LoginView ID="LoginView1" runat="server">
                        <LoggedInTemplate>
                            Bienvenido:&nbsp;<strong>
                                <asp:LoginName ID="LoginName1" runat="server" />
                            </strong>
                            <asp:LoginStatus ID="LoginStatus1" runat="server" LogoutPageUrl="cerrar.aspx" LogoutText="Cerrar sesión" />
                        </LoggedInTemplate>
                    </asp:LoginView>
                    <br />
                    <% DateTime.Now.ToLongDateString();%>
                </div>
                <asp:ContentPlaceHolder ID="phbody" runat="server">
                </asp:ContentPlaceHolder>
            </div>
        </div>
   
    </form>
</body>
</html>
